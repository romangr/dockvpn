#!/bin/sh
set -e

# Ensure tun device exists
[ -d /dev/net ] || mkdir -p /dev/net
[ -c /dev/net/tun ] || mknod /dev/net/tun c 10 200

cd /etc/openvpn
# This file tells `serveconfig` that there is a config there
touch placeholder

# Generate ECDSA key and cert if missing (secp384r1)
[ -f key.pem ] || openssl ecparam -name secp384r1 -genkey -noout -out key.pem
chmod 600 key.pem
[ -f cert.pem ] || openssl req -new -x509 -key key.pem -out cert.pem -days 24855 -subj /CN=OpenVPN/

# IPv6 subnet to use for VPN clients
VPN_IPV6_SUBNET="2001:db8:0:123::/64"

# IPv4 config: TCP 443
[ -f tcp443.conf ] || cat >tcp443.conf <<EOF
server 192.168.255.0 255.255.255.128
server-ipv6 $VPN_IPV6_SUBNET
cipher AES-256-GCM
ncp-ciphers AES-256-GCM:AES-128-GCM
ecdh-curve secp384r1
verb 3
duplicate-cn
key key.pem
ca cert.pem
cert cert.pem
keepalive 10 60
persist-key
persist-tun
push "dhcp-option DNS 77.88.8.8"
push "route-ipv6 2000::/3"
push "dhcp-option DNS6 2606:4700:4700::1111"
push "dhcp-option DNS6 2606:4700:4700::1001"

proto tcp-server
port 443
dev tun443
status openvpn-status-443.log
EOF

# IPv4 config: UDP 1194
[ -f udp1194.conf ] || cat >udp1194.conf <<EOF
server 192.168.255.128 255.255.255.128
server-ipv6 $VPN_IPV6_SUBNET
cipher AES-256-GCM
ncp-ciphers AES-256-GCM:AES-128-GCM
ecdh-curve secp384r1
verb 3
duplicate-cn
key key.pem
ca cert.pem
cert cert.pem
keepalive 10 60
persist-key
persist-tun
push "dhcp-option DNS 77.88.8.8"
push "route-ipv6 2000::/3"
push "dhcp-option DNS6 2606:4700:4700::1111"
push "dhcp-option DNS6 2606:4700:4700::1001"

proto udp
port 1194
dev tun1194
status openvpn-status-1194.log
EOF

# Get public IPv4 address
MY_IP_ADDR=$(curl -s http://myip.enix.org/REMOTE_ADDR)
[ "$MY_IP_ADDR" ] || {
    echo "Could not determine public IPv4 address."
    exit 1
}

# Generate client config
[ -f client.ovpn ] || cat >client.ovpn <<EOF
client
dev tun
nobind
cipher AES-256-GCM
ncp-ciphers AES-256-GCM:AES-128-GCM
redirect-gateway def1
tun-ipv6
route-ipv6 2000::/3

<key>
$(cat key.pem)
</key>
<cert>
$(cat cert.pem)
</cert>
<ca>
$(cat cert.pem)
</ca>

<connection>
remote $MY_IP_ADDR 1194 udp
</connection>

<connection>
remote $MY_IP_ADDR 443 tcp-client
</connection>
EOF

# HTTP version of the client config
[ -f client.http ] || cat >client.http <<EOF
HTTP/1.0 200 OK
Content-Type: application/x-openvpn-profile
Content-Length: $(wc -c < client.ovpn)

$(cat client.ovpn)
EOF

# Enable IP forwarding
sysctl -w net.ipv4.ip_forward=1
sysctl -w net.ipv6.conf.all.forwarding=1

# Enable IPv4 NAT
iptables -t nat -A POSTROUTING -s 192.168.255.0/24 -o eth0 -j MASQUERADE

# Logs
touch tcp443.log udp1194.log
LOGFILE_TCP=tcp443.log
LOGFILE_UDP=udp1194.log
[ -z "$DISABLE_LOGS" ] || {
    LOGFILE_TCP=/dev/null
    LOGFILE_UDP=/dev/null
}

# Start OpenVPN servers
while true; do openvpn tcp443.conf; done >> "$LOGFILE_TCP" &
while true; do openvpn udp1194.conf; done >> "$LOGFILE_UDP" &

# Tail logs
tail -F *.log
